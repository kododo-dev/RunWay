<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- The test host follows the runtime the tests run on. -->
  <PropertyGroup>
    <AspNetCoreTestVersion>10.0.13</AspNetCoreTestVersion>
    <AspNetCoreTestVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.31</AspNetCoreTestVersion>
    <AspNetCoreTestVersion Condition="'$(TargetFramework)' == 'net9.0'">9.0.20</AspNetCoreTestVersion>
  </PropertyGroup>

  <!--
    EF Core follows the target framework: EF Core 10 is not binary compatible with code built against 8 (ExecuteUpdate's
    SetPropertyCalls is gone), so an app on EF Core 10 needs RunWay built against 10.
  -->
  <PropertyGroup>
    <EfCoreVersion>10.0.13</EfCoreVersion>
    <NpgsqlEfCoreVersion>10.0.3</NpgsqlEfCoreVersion>
    <NpgsqlVersion>10.0.3</NpgsqlVersion>
    <EfCoreVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.29</EfCoreVersion>
    <NpgsqlEfCoreVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.11</NpgsqlEfCoreVersion>
    <NpgsqlVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.9</NpgsqlVersion>
    <EfCoreVersion Condition="'$(TargetFramework)' == 'net9.0'">9.0.21</EfCoreVersion>
    <NpgsqlEfCoreVersion Condition="'$(TargetFramework)' == 'net9.0'">9.0.4</NpgsqlEfCoreVersion>
    <NpgsqlVersion Condition="'$(TargetFramework)' == 'net9.0'">9.0.5</NpgsqlVersion>
  </PropertyGroup>

  <!--
    Microsoft.Data.SqlClient (through EF Core SqlServer) depends on System.Security.Cryptography.Pkcs versions with known
    vulnerabilities, so RunWay.SqlServer references the patched ones directly, as ConfigWay does.
  -->
  <PropertyGroup>
    <PkcsVersion>10.0.13</PkcsVersion>
    <PkcsVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.2</PkcsVersion>
    <PkcsVersion Condition="'$(TargetFramework)' == 'net9.0'">9.0.21</PkcsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlEfCoreVersion)" />
    <PackageVersion Include="Npgsql" Version="$(NpgsqlVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EfCoreVersion)" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(PkcsVersion)" />

    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <!-- 10.x on every target: the .NET 10 SDK prunes older versions, which drops the task writing the manifest; Way.Shell needs 10.0.13. -->
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />

    <PackageVersion Include="NCrontab" Version="3.4.0" />
    <PackageVersion Include="Kododo.Reiho.AspNetCore" Version="2.1.1" />
    <PackageVersion Include="Kododo.Way.Shell" Version="2.0.0-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="$(AspNetCoreTestVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
  </ItemGroup>

</Project>
