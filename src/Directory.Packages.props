<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- The test host follows the runtime the tests run on. -->
  <PropertyGroup>
    <AspNetCoreTestVersion>10.0.15</AspNetCoreTestVersion>
    <AspNetCoreTestVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0</AspNetCoreTestVersion>
  </PropertyGroup>

  <!--
    EF Core follows the target framework: EF Core 11 only targets net11.0, and an app on EF Core 11 needs RunWay built
    against 11.
  -->
  <PropertyGroup>
    <EfCoreVersion>10.0.15</EfCoreVersion>
    <NpgsqlEfCoreVersion>10.0.4</NpgsqlEfCoreVersion>
    <NpgsqlVersion>10.0.4</NpgsqlVersion>
    <EfCoreVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0</EfCoreVersion>
    <NpgsqlEfCoreVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0</NpgsqlEfCoreVersion>
    <NpgsqlVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0</NpgsqlVersion>
  </PropertyGroup>

  <!--
    Microsoft.Data.SqlClient (through EF Core SqlServer, up to 7.1.1) depends on System.Security.Cryptography.Pkcs versions
    with known vulnerabilities, so RunWay.SqlServer references the patched ones directly.
  -->
  <PropertyGroup>
    <PkcsVersion>10.0.15</PkcsVersion>
    <PkcsVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0</PkcsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlEfCoreVersion)" />
    <PackageVersion Include="Npgsql" Version="$(NpgsqlVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EfCoreVersion)" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="$(PkcsVersion)" />

    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />

    <PackageVersion Include="NCrontab" Version="3.4.0" />
    <PackageVersion Include="Kododo.Reiho.AspNetCore" Version="3.0.0" />
    <PackageVersion Include="Kododo.Way.Shell" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="$(AspNetCoreTestVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.assert" Version="3.2.2" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.17.0" />
  </ItemGroup>

</Project>
