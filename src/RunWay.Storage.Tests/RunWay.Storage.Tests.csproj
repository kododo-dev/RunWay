<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- Base classes for the storage tests in RunWay.PostgreSQL.Tests and RunWay.SqlServer.Tests; nothing to run here. -->
    <IsTestProject>false</IsTestProject>
    <!-- xUnit1051 asks for TestContext.Current.CancellationToken in every call; the tests are short. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.extensibility.core" />
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunWay\RunWay.csproj" />
    <ProjectReference Include="..\RunWay.Core\RunWay.Core.csproj" />
  </ItemGroup>

</Project>
